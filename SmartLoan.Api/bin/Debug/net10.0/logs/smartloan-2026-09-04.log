    SELECT l."Id", l."CreatedAt", l."CustomerId", l."DailyAmount", l."EligibilityDays", l."IsDeleted", l."LoanAmount", l."ServiceFee", l."Status", l."TotalDays", c0."Id" AS "Id0", c0."Address", c0."FullName", c0."IsDeleted" AS "IsDeleted0", c0."Phone"
    FROM "LoanApplications" AS l
    INNER JOIN (
        SELECT c."Id", c."Address", c."FullName", c."IsDeleted", c."Phone"
        FROM "Customers" AS c
        WHERE NOT (c."IsDeleted")
    ) AS c0 ON l."CustomerId" = c0."Id"
    WHERE NOT (l."IsDeleted") AND l."Id" = @request_LoanId
    LIMIT 1
) AS s
LEFT JOIN "Payments" AS p ON s."Id" = p."LoanApplicationId"
ORDER BY s."Id", s."Id0" 
