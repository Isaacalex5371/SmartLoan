SELECT l0."Id", c0."FullName", l0."DailyAmount", l0."LoanAmount", l0."ServiceFee", l0."Status", l0."CreatedAt", CAST((
    SELECT COALESCE(sum(p."Amount"), 0.0)
    FROM "Payments" AS p
    WHERE l0."Id" = p."LoanApplicationId") / l0."DailyAmount" AS integer)
FROM (
    SELECT l."Id", l."CreatedAt", l."CustomerId", l."DailyAmount", l."LoanAmount", l."ServiceFee", l."Status"
    FROM "LoanApplications" AS l
    WHERE NOT (l."IsDeleted")
    ORDER BY l."CreatedAt" DESC
    LIMIT @p1 OFFSET @p
) AS l0
INNER JOIN (
    SELECT c."Id", c."FullName"
    FROM "Customers" AS c
    WHERE NOT (c."IsDeleted")
) AS c0 ON l0."CustomerId" = c0."Id"
ORDER BY l0."CreatedAt" DESC 
