INNER JOIN (
    SELECT c."Id", c."FullName"
    FROM "Customers" AS c
    WHERE NOT (c."IsDeleted")
) AS c0 ON l."CustomerId" = c0."Id"
WHERE NOT (l."IsDeleted") AND l."CustomerId" = @request_CustomerId
ORDER BY l."CreatedAt" DESC 
