SELECT l."Id", c0."FullName", l."DailyAmount", l."LoanAmount", l."ServiceFee", l."Status", l."CreatedAt", CAST((
    SELECT COALESCE(sum(p."Amount"), 0.0)
    FROM "Payments" AS p
    WHERE l."Id" = p."LoanApplicationId") / l."DailyAmount" AS integer)
