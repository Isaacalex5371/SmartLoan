SELECT l."Id", c0."FullName", l."DailyAmount", l."LoanAmount", l."ServiceFee", l."Status", l."CreatedAt", CAST((
    SELECT COALESCE(sum(p."Amount"), 0.0)
    FROM "Payments" AS p
    WHERE l."Id" = p."LoanApplicationId") / l."DailyAmount" AS integer)
FROM "LoanApplications" AS l
INNER JOIN (
    SELECT c."Id", c."FullName"
    FROM "Customers" AS c
    WHERE NOT (c."IsDeleted")
) AS c0 ON l."CustomerId" = c0."Id"
WHERE NOT (l."IsDeleted") AND l."CustomerId" = @request_CustomerId
ORDER BY l."CreatedAt" DESC 
