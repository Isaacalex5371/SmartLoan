    WHERE NOT (l."IsDeleted") AND l."Id" = @request_Id
    LIMIT 1
) AS s
LEFT JOIN "Payments" AS p ON s."Id" = p."LoanApplicationId"
ORDER BY s."Id", s."Id0" 
